{
  "manifest_version": 3,
  "name": "ÉcoleDirecte - Impression Cahier de Texte",
  "short_name": "ED Impression",
  "version": "1.3.0",
  "description": "Imprimez un cahier de texte clair avec tous les devoirs à venir sur ÉcoleDirecte.",
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon-128.svg"
  },
  "action": {
    "default_title": "ED Impression - Cahier de texte",
    "default_icon": {
      "16": "icons/icon.svg",
      "48": "icons/icon.svg",
      "128": "icons/icon-128.svg"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ecoledirecte.com/*"],
      "js": ["runtime.js", "interception.js", "schedule.js", "homework.js", "content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}